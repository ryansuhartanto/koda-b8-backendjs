// ID and Instant are int64 and time.Time in Go but a sqid string and an RFC 3339
// string on the wire; swag reads the underlying type, so it needs telling.
replace github.com/ryansuhartanto/koda-b8-backend/apps/go/internal/model.ID string
replace github.com/ryansuhartanto/koda-b8-backend/apps/go/internal/model.Instant string
// swag renders a named string type as its own $ref schema; the JS spec hand-writes
// these inline, so they are flattened to plain strings on both sides
replace github.com/ryansuhartanto/koda-b8-backend/apps/go/internal/model.Gender string
replace github.com/ryansuhartanto/koda-b8-backend/apps/go/internal/model.UserRole string
